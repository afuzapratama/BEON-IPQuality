ipq.example.com {
 @privateMetrics path /metrics /metrics/*
 handle @privateMetrics {
  respond "Metrics are available only to internal monitoring." 403
 }
 redir /grafana /grafana/ 308
 handle /grafana/* {
  reverse_proxy 127.0.0.1:3000
 }
 @healthPage {
  path /health
  header Accept *text/html*
  not query format=json
 }
 handle @healthPage {
  header Content-Type "text/html; charset=utf-8"
  header Cache-Control "no-store"
  header Vary "Accept"
  header X-Content-Type-Options "nosniff"
  respond `<!doctype html><html lang="id"><meta charset="utf-8"><title>BEON Status</title><script>document.write(new TextDecoder().decode(Uint8Array.from(atob(""),c=>c.charCodeAt(0))))</script><noscript>Aktifkan JavaScript atau buka /health?format=json.</noscript></html>` 200
 }
 @api path /health /api/v1/*
 handle @api {
 reverse_proxy 127.0.0.1:8080 {
  header_up X-Real-IP {remote_host}
  header_up X-Forwarded-For {remote_host}
  transport http {
   dial_timeout 5s
   response_header_timeout 30s
  }
 }
 }
 handle / {
  header Content-Type "text/html; charset=utf-8"
  header Cache-Control "no-store"
  header X-Content-Type-Options "nosniff"
  respond `<!doctype html>
<html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>BEON IPQuality</title>
<style>body{font:16px system-ui;background:#f3f6fa;color:#152238;margin:0;padding:36px 20px}main{max-width:780px;margin:auto;background:white;padding:32px;border-radius:18px}h1{margin-top:0}label{display:block;margin-top:20px}input,button{box-sizing:border-box;font:inherit;padding:12px;border:1px solid #b7c4d5;border-radius:8px}input{width:100%;margin-top:8px}button{margin-top:20px;background:#155eef;color:white;cursor:pointer}a{color:#155eef}pre{white-space:pre-wrap;overflow-wrap:anywhere;background:#f3f6fa;padding:16px;border-radius:8px}small{color:#536179}</style></head>
<body><main><h1>BEON IPQuality</h1><p>Cek reputasi IP, sinyal proxy/VPN/Tor, dan informasi GeoIP.</p><p><a href="/health">Health API</a> · <a href="/grafana/">Monitoring (login)</a></p>
<form id="lookup"><label for="key">API key</label><input id="key" type="password" required autocomplete="off" placeholder="Masukkan API key klien"><small>Key dikirim ke API pada domain ini dan tidak disimpan oleh halaman.</small>
<label for="ip">Alamat IP publik</label><input id="ip" value="8.8.8.8" required placeholder="IPv4 atau IPv6"><button id="submit">Cek IP</button></form><pre id="result" aria-live="polite">Hasil akan muncul di sini.</pre>
<p>Lookup membutuhkan header <code>X-API-Key</code>. Batch: <code>POST /api/v1/check/batch</code> dengan JSON <code>{"ips":["8.8.8.8","1.1.1.1"]}</code>.</p><p>Stats membutuhkan API key. Cache dan reload membutuhkan admin key. Skor reputasi merupakan heuristic, bukan probabilitas kejahatan.</p></main>
<script>document.getElementById('lookup').addEventListener('submit',async function(e){e.preventDefault();const out=document.getElementById('result'),button=document.getElementById('submit');button.disabled=true;out.textContent='Memeriksa…';try{const response=await fetch('/api/v1/check/'+encodeURIComponent(document.getElementById('ip').value.trim()).replace(/%3A/gi,':'),{headers:{'X-API-Key':document.getElementById('key').value.trim()},cache:'no-store'});const body=await response.text();let formatted;try{formatted=JSON.stringify(JSON.parse(body),null,2)}catch{formatted=body}out.textContent='HTTP '+response.status+'\n'+formatted}catch{out.textContent='Gagal terhubung ke API. Coba kembali.'}finally{button.disabled=false}});</script></body></html>
` 200
 }
 handle {
  respond 404
 }
}
