PROJECT_ROOT=/opt/beon-ipquality
BACKUP_DIR=/opt/beon-ipquality/backups
BACKUP_RECIPIENT_FILE=/etc/beon-ipquality/backup.recipient
LOCAL_RETENTION_DAYS=7
OFFSITE_RETENTION_DAYS=30
BUNNY_BUCKET=
BUNNY_REGION=sg
BUNNY_ENDPOINT=https://sg-s3.storage.bunnycdn.com
BUNNY_ACCESS_KEY_ID=
BUNNY_SECRET_ACCESS_KEY=
BUNNY_PREFIX=beon-ipquality
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Set only when using a Telegram forum topic.
TELEGRAM_MESSAGE_THREAD_ID=
HEALTH_URL=http://127.0.0.1:8080/health
OPS_STATE_DIR=/var/lib/beon-ipquality
COMPOSE_PROJECT_NAME=beon-ipquality

# Enable only after the separate production monitoring stack is healthy.
MONITORING_ENABLED=false
