COMPOSE_PROJECT_NAME=beon-ipquality
PROJECT_ROOT=/opt/beon-ipquality
MMDB_HOST_DIR=/opt/beon-ipquality/data/mmdb
# Populate these from the release deployment-lock.env (all four are required).
API_IMAGE=
INGESTOR_IMAGE=
COMPILER_IMAGE=
JUDGE_IMAGE=
POSTGRES_USER=beon
POSTGRES_DB=ipquality
POSTGRES_PASSWORD=
REDIS_PASSWORD=
API_KEY=
ADMIN_API_KEY=
TRUSTED_PROXIES=
API_PORT=8080
REDIS_ENABLED=true
MMDB_COMPILE_INTERVAL=15m
MMDB_RELOAD_INTERVAL=5m
MMDB_MAX_AGE=1h
DB_MAX_CONNECTIONS=10
DB_MIN_CONNECTIONS=1
# Initial caps; measure dataset and fit the total to VPS RAM before deployment.
API_MEMORY=256m
INGESTOR_MEMORY=1024m
COMPILER_MEMORY=2g
POSTGRES_MEMORY=768m
REDIS_MEMORY=192m
REDIS_MAXMEMORY=128mb
INGESTOR_CONCURRENCY=4
REPUTATION_RETENTION=720h
FEED_HISTORY_RETENTION=720h

# Go GC soft budgets must be below the corresponding container caps.
API_GO_MEMORY_LIMIT=128MiB
INGESTOR_GO_MEMORY_LIMIT=700MiB
COMPILER_GO_MEMORY_LIMIT=1100MiB
