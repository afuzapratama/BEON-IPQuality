# Environment Variables for BEON-IPQuality
# 
# This file is auto-generated during installation.
# Manual setup: Copy to .env and modify values
#
# ⚠️  All credentials are AUTO-GENERATED during installation
# ⚠️  Only MaxMind License Key requires manual input
#===============================================================================

# Copy this file to .env. Compose intentionally refuses to start until all
# required secrets below are set to strong, unique values.

# PostgreSQL
POSTGRES_PASSWORD=
POSTGRES_USER=beon
POSTGRES_DB=ipquality

# ClickHouse (only required by the monitoring profile)
CLICKHOUSE_USER=beon
CLICKHOUSE_PASSWORD=

# Redis
REDIS_PASSWORD=

# Grafana (only required by the monitoring profile)
GRAFANA_PASSWORD=

# API key (minimum 32 random characters)
API_KEY=

# MaxMind License Key (MANUAL INPUT REQUIRED)
# Get your FREE license key at: https://www.maxmind.com/en/geolite2/signup
# Steps:
#   1. Register for a free account
#   2. Go to Account → Manage License Keys  
#   3. Generate a new license key
MAXMIND_LICENSE_KEY=your_maxmind_license_key

# Environment
ENVIRONMENT=production
LOG_LEVEL=info

# Services bind to loopback by default. Set 0.0.0.0 only when a firewall or
# reverse proxy is configured in front of the API.
API_BIND_ADDRESS=127.0.0.1
API_PORT=8080

# Separate admin secret; empty disables reload/cache administration
ADMIN_API_KEY=
# Explicit proxy peer IPs/CIDRs, comma-separated. Empty trusts no proxy.
# For host Nginx + Docker, determine its actual peer address first.
TRUSTED_PROXIES=
